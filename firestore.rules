rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin Helper Check
    function isAdmin() {
      return request.auth != null && (
        ('email' in request.auth.token && (
          request.auth.token.email == 'admin@susbee.com' || 
          request.auth.token.email == 'susbeebeautystudio@gmail.com' ||
          request.auth.token.email == 'sagarchokhal0@gmail.com'
        )) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // User profiles
    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (
        request.auth != null && 
        request.auth.uid == userId && 
        (!('role' in request.resource.data) || request.resource.data.role != 'admin')
      );
      allow delete: if isAdmin();
      
      // User-specific bookings subcollection
      match /bookings/{bookingId} {
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }
    }

    // Phone-to-email mapping for secure unauthenticated phone-based sign-in lookup
    match /phone_to_email/{phone} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Global bookings collection
    match /bookings/{bookingId} {
      allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;
      allow read, update, delete: if isAdmin() || (request.auth != null && resource != null && resource.data.customerId == request.auth.uid);
    }

    // CMS and Dynamic website content - public readable, admin writable
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /training_courses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /team/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /before_after/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /special_offers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hero_slides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /popup_announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /website_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
